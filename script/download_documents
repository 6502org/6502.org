#!/usr/bin/env php
<?php
/**
 * Download all of the documents from the mirrors.
 *
 * Usage: php script/download_documents [options]
 *
 * Downloads all document files from their mirror URLs into the
 * given directory, recreating the folder structure. Files are
 * verified by SHA1 hash. Existing files with matching hashes
 * are skipped.
 *
 * Exit status: 0 if all files downloaded successfully, 1 if not.
 */

$options = getopt('', ['output:', 'delay:', 'retry-delay:', 'retries:', 'filter:', 'dry-run', 'help']);

if (isset($options['help'])) {
    echo "Usage: php $argv[0] [options]\n\n";
    echo "Options:\n";
    echo "  --output=DIR            Destination directory (default: public/documents/)\n";
    echo "  --delay=SECONDS         Delay between downloads (default: 5)\n";
    echo "  --retries=N             Max retries per file (default: 5)\n";
    echo "  --retry-delay=SECONDS   Delay before retry (default: 30)\n";
    echo "  --filter=STRING         Only download files whose path contains STRING\n";
    echo "  --dry-run               Show local path and mirror URL for each file\n";
    echo "  --help                  Show this help message\n";
    exit(0);
}

if (!defined('MAD_ENV')) define('MAD_ENV', 'production');
require_once dirname(dirname(__FILE__)).'/config/environment.php';
Mad_Model_Base::establishConnection();


/**
 * Finds DocumentFile records that are downloadable, optionally
 * filtered by a path substring.
 */
function findFiles($filter = null)
{
    $files = DocumentFile::find('all', [
        'conditions' => "mirror_url IS NOT NULL AND mirror_url != ''",
        'order'      => 'folder_id, filename'
    ]);

    if ($filter === null) {
        return $files;
    }

    $filtered = [];
    foreach ($files as $file) {
        if (stripos(relativePath($file), $filter) !== false) {
            $filtered[] = $file;
        }
    }
    return $filtered;
}

/**
 * Returns the folder-relative path for a DocumentFile,
 * e.g. "datasheets/mos/mos_6500_mpu_nov_1985.pdf"
 */
function relativePath($file)
{
    return $file->documentFolder->path . $file->filename;
}

/**
 * Checks all files against disk, returns an array of items
 * that need downloading. Each item has 'file', 'reason',
 * 'relative_path', and 'full_path'.
 */
function checkFiles($files, $destDir)
{
    $needed = [];
    $skipped = 0;
    $total = count($files);

    echo "Checking existing files...\n";

    foreach ($files as $index => $file) {
        $relPath = relativePath($file);

        $prefix = sprintf("  [%d/%d] ", $index + 1, $total);
        $maxName = 80 - strlen($prefix);
        $name = strlen($relPath) > $maxName
            ? '...' . substr($relPath, -(($maxName) - 3))
            : $relPath;
        printf("\r%-80s", $prefix . $name);

        if ($file->isIntact()) {
            $skipped++;
            continue;
        }

        $needed[] = [
            'file'          => $file,
            'reason'        => $file->isReadable() ? 'corrupt' : 'missing',
            'relative_path' => $relPath,
            'full_path'     => $destDir . '/' . $relPath,
        ];
    }

    printf("\r  %d OK, %d to download                                                      \n\n",
            $skipped, count($needed));

    return $needed;
}

/**
 * Checks that there is enough disk space for the needed downloads.
 * Exits with an error if not.
 */
function checkDiskSpace($needed, $destDir)
{
    $neededBytes = 0;
    foreach ($needed as $item) {
        $neededBytes += $item['file']->filesize;
    }
    $freeBytes = disk_free_space($destDir);
    if ($freeBytes !== false && $freeBytes < $neededBytes) {
        fprintf(STDERR, "Error: not enough disk space. Need %s but only %s available.\n",
                formatBytes($neededBytes), formatBytes($freeBytes));
        exit(1);
    }
}

/**
 * Downloads a single file from $url to $destPath with retries.
 * Returns true on success, false on failure.
 */
function downloadFile($url, $destPath, $expectedSha1, $expectedSize, $maxRetries, $retryDelay)
{
    $dirPath = dirname($destPath);
    if (!is_dir($dirPath)) {
        if (!mkdir($dirPath, 0755, true)) {
            fprintf(STDERR, "  Error: could not create directory %s\n", $dirPath);
            return false;
        }
    }

    $tmpFile = tempnam(MAD_ROOT . '/tmp', 'download_' . getmypid() . '_');
    rename($tmpFile, $tmpFile . '.bin');
    $tmpFile = $tmpFile . '.bin';

    for ($attempt = 1; $attempt <= $maxRetries; $attempt++) {
        if ($attempt > 1) {
            for ($w = $retryDelay; $w > 0; $w--) {
                printf("\r  Retry %d/%d in %ds...  ", $attempt, $maxRetries, $w);
                sleep(1);
            }
            printf("\r  Retry %d/%d...            \n", $attempt, $maxRetries);
        }

        echo "  $url\n";

        if (curlDownload($url, $tmpFile, $expectedSize)
            && verifyDownload($tmpFile, $expectedSha1)
            && moveToDestination($tmpFile, $destPath)) {
            return true;
        }
    }

    // Clean up temp file if still around
    if (file_exists($tmpFile)) {
        unlink($tmpFile);
    }

    fprintf(STDERR, "  Gave up after %d attempts\n", $maxRetries);
    return false;
}

/**
 * Downloads $url to $tmpFile using curl with progress display.
 * Returns true on success.
 */
function curlDownload($url, $tmpFile, $expectedSize)
{
    $fp = fopen($tmpFile, 'wb');
    if ($fp === false) {
        fprintf(STDERR, "  Error: could not open temp file for writing\n");
        return false;
    }

    echo "  Connecting...\r";

    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $url);
    curl_setopt($ch, CURLOPT_FILE, $fp);
    curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
    curl_setopt($ch, CURLOPT_MAXREDIRS, 5);
    curl_setopt($ch, CURLOPT_FAILONERROR, true);
    curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 15);
    curl_setopt($ch, CURLOPT_TIMEOUT, 300);
    curl_setopt($ch, CURLOPT_LOW_SPEED_LIMIT, 1024);
    curl_setopt($ch, CURLOPT_LOW_SPEED_TIME, 30);
    curl_setopt($ch, CURLOPT_USERAGENT,
        'Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0');
    curl_setopt($ch, CURLOPT_NOPROGRESS, false);
    curl_setopt($ch, CURLOPT_PROGRESSFUNCTION,
        function ($ch, $dlTotal, $dlNow, $ulTotal, $ulNow) use ($expectedSize) {
            if ($dlNow > 0) {
                $total = $dlTotal > 0 ? $dlTotal : $expectedSize;
                if ($total > 0) {
                    $pct = min(100, (int)($dlNow * 100 / $total));
                    printf("\r  %s / %s (%d%%)",
                        formatBytes($dlNow), formatBytes($total), $pct);
                } else {
                    echo "\r  " . formatBytes($dlNow);
                }
            }
            return 0;
        }
    );

    $result = curl_exec($ch);
    $error = curl_error($ch);
    $errno = curl_errno($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    fclose($fp);

    echo "\n";

    if ($result === false) {
        fprintf(STDERR, "  Failed: %s (curl error %d, HTTP %d)\n", $error, $errno, $httpCode);
        if (file_exists($tmpFile)) { unlink($tmpFile); }
        return false;
    }

    if (!file_exists($tmpFile) || filesize($tmpFile) === 0) {
        fprintf(STDERR, "  Failed: 0 bytes received\n");
        if (file_exists($tmpFile)) { unlink($tmpFile); }
        return false;
    }

    return true;
}

/**
 * Verifies the SHA1 hash of a downloaded file.
 */
function verifyDownload($tmpFile, $expectedSha1)
{
    $actualSha1 = sha1_file($tmpFile);
    if ($actualSha1 !== $expectedSha1) {
        fprintf(STDERR, "  SHA1 mismatch: expected %s, got %s\n", $expectedSha1, $actualSha1);
        unlink($tmpFile);
        return false;
    }
    return true;
}

/**
 * Moves a downloaded temp file to its final destination.
 */
function moveToDestination($tmpFile, $destPath)
{
    if (!rename($tmpFile, $destPath)) {
        fprintf(STDERR, "  Error: could not move file to %s\n", $destPath);
        unlink($tmpFile);
        return false;
    }
    return true;
}

function formatBytes($bytes)
{
    if ($bytes >= 1073741824) {
        return sprintf('%.1f GB', $bytes / 1073741824);
    } elseif ($bytes >= 1048576) {
        return sprintf('%.1f MB', $bytes / 1048576);
    } elseif ($bytes >= 1024) {
        return sprintf('%.0f KB', $bytes / 1024);
    }
    return sprintf('%d B', $bytes);
}


/*
 * Main
 */

$destDir = isset($options['output']) ? rtrim($options['output'], '/') : MAD_ROOT . '/public/documents';
$downloadDelay = isset($options['delay']) ? (int)$options['delay'] : 5;
$maxRetries = isset($options['retries']) ? (int)$options['retries'] : 5;
$retryDelay = isset($options['retry-delay']) ? (int)$options['retry-delay'] : 30;
$filter = isset($options['filter']) ? $options['filter'] : null;

if (!is_dir($destDir)) {
    if (!mkdir($destDir, 0755, true)) {
        fprintf(STDERR, "Error: could not create '%s'\n", $destDir);
        exit(1);
    }
}

$files = findFiles($filter);

// Dry run: show paths and exit
if (isset($options['dry-run'])) {
    foreach ($files as $file) {
        echo relativePath($file) . "\n  $file->mirror_url\n\n";
    }
    echo count($files) . " files\n";
    exit(0);
}

$totalFiles = count($files);
$totalSize = 0;
foreach ($files as $file) {
    $totalSize += $file->filesize;
}

echo "Destination: $destDir\n";
echo "Found $totalFiles files (" . formatBytes($totalSize) . " total)\n\n";

$needed = checkFiles($files, $destDir);

if (count($needed) === 0) {
    echo "Everything is up to date.\n";
    exit(0);
}

checkDiskSpace($needed, $destDir);

$downloaded = 0;
$failures = [];
$consecutiveFailures = 0;
$totalNeeded = count($needed);

foreach ($needed as $index => $item) {
    $file = $item['file'];
    $num = $index + 1;

    if ($item['reason'] === 'corrupt') {
        echo "[$num/$totalNeeded] Re-downloading (corrupt) $item[relative_path]\n";
    } else {
        echo "[$num/$totalNeeded] Downloading $item[relative_path]\n";
    }

    if (downloadFile($file->mirror_url, $item['full_path'], $file->sha1,
                     $file->filesize, $maxRetries, $retryDelay)) {
        $downloaded++;
        $consecutiveFailures = 0;

        if ($downloadDelay > 0 && $index < $totalNeeded - 1) {
            for ($w = $downloadDelay; $w > 0; $w--) {
                printf("\r  Waiting %ds...  ", $w);
                sleep(1);
            }
            echo "\r                  \r";
        }
    } else {
        $failures[] = $item['relative_path'];
        $consecutiveFailures++;

        if ($consecutiveFailures >= 2) {
            fprintf(STDERR, "\nTwo consecutive failures. archive.org may be down. Stopping.\n");
            break;
        }
    }
}

// Summary
echo "\n";
echo "Total:      $totalFiles\n";
echo "Skipped:    " . ($totalFiles - $totalNeeded) . " (already exist with correct SHA1)\n";
echo "Downloaded: $downloaded\n";
echo "Failed:     " . count($failures) . "\n";

if (count($failures) > 0) {
    echo "\nFailed files:\n";
    foreach ($failures as $f) {
        echo "  $f\n";
    }
    exit(1);
}

exit(0);
